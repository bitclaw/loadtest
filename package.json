{
  "name": "@bitclaw/loadtest",
  "version": "1.5.0",
  "description": "Load testing framework for SQLite-backed web applications",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "loadtest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "knip": "knip",
    "prepublishOnly": "npm run build && chmod +x dist/cli.js && npm run test",
    "publish:dev": "npm run build && npm publish --tag dev --access public",
    "publish:patch": "npm version patch && git push --follow-tags",
    "publish:minor": "npm version minor && git push --follow-tags",
    "publish:major": "npm version major && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitclaw/loadtest.git"
  },
  "keywords": [
    "loadtest",
    "benchmark",
    "sqlite",
    "bun",
    "k6"
  ],
  "author": "bitclaw",
  "license": "MIT",
  "dependencies": {
    "@bitclaw/sqlite": "2.1.0",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "knip": "6.14.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
